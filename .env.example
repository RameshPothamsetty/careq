# =====================================================================
# CareQ — Docker Compose environment
#
#   cp .env.example .env     then edit values
#   docker compose up -d --build
#
# The real .env is gitignored — never commit it.
# =====================================================================

# MySQL root password — used BOTH for the mysql container and as the
# datasource password for every backend service (one shared DB: careq_db).
MYSQL_PASSWORD=root

# JWT signing secret — must be IDENTICAL for api-gateway and auth-service
# (they sign/validate the same tokens). Generate a long random value for
# anything beyond local testing, e.g.:
#   openssl rand -base64 48
JWT_SECRET=ChangeMeGenerateALongRandomSecretForProduction

# Groq API key for AI symptom triage (queue-service only).
# If missing or empty, AiTriageService falls back to NORMAL triage so
# patients can always join the queue. Get one at https://console.groq.com
GROQ_API_KEY=
