# =====================================================================
# CareQ — Docker Compose environment
#
#   cp .env.example .env     then edit values
#   docker compose up -d --build
#
# The real .env is gitignored — never commit it.
# =====================================================================

# MySQL root password — used BOTH for the mysql container and as the
# datasource password for every backend service (one shared DB: careq_db).
MYSQL_PASSWORD=root

# JWT signing secret — must be IDENTICAL for api-gateway and auth-service
# (they sign/validate the same tokens). Generate a long random value for
# anything beyond local testing, e.g.:
#   openssl rand -base64 48
JWT_SECRET=ChangeMeGenerateALongRandomSecretForProduction

# Groq API key for AI symptom triage (queue-service only).
# If missing or empty, AiTriageService falls back to NORMAL triage so
# patients can always join the queue. Get one at https://console.groq.com
GROQ_API_KEY=

# RabbitMQ credentials (Day 13) — used by queue-service (publisher) and
# notification-service (consumer). Dev defaults are the built-in guest/guest;
# the management UI is at http://localhost:15672.
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Web Push (VAPID) keys (Day 16) — notification-service delivers queue events
# as browser push notifications. Generate a pair with:
#   bash scripts/generate-vapid-keys.sh
# VITE_VAPID_PUBLIC_KEY must ALSO be set where the frontend is built (Vercel
# project env / the docker-compose frontend build arg). If these are empty,
# push delivery is disabled and in-app notifications keep working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:careq@example.com
VITE_VAPID_PUBLIC_KEY=

# ── Day 17 — email verification + password reset (auth-service) ──────────
# SendGrid API key (https://app.sendgrid.com/settings/api_keys). Free tier:
# 100 emails/day. Also verify a SINGLE SENDER email in SendGrid and put it in
# APP_MAIL_FROM — no domain ownership needed.
#
# Local dev keeps AUTH_EMAIL_VERIFICATION_ENABLED=false (signup returns a JWT
# as before). The Azure CD pipeline sets it to true + injects SENDGRID_API_KEY
# from GitHub secrets. If the key is empty, verification emails are skipped
# (fail-open — the auth flow still works, accounts just stay unverified).
SENDGRID_API_KEY=
APP_MAIL_FROM=careq@example.com
APP_FRONTEND_BASE_URL=http://localhost:3030
AUTH_EMAIL_VERIFICATION_ENABLED=false
